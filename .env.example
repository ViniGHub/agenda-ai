# Copie para .env (que fica fora do git) e preencha.
# Chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: outros modelos do Groq (linguagem e transcrição de voz)
# AGENDA_IA_MODELO=openai/gpt-oss-120b
# AGENDA_IA_MODELO_AUDIO=whisper-large-v3-turbo

# Opcional: login com Google para a área privada
# GOOGLE_CLIENT_ID=0000000000-xxxx.apps.googleusercontent.com
# AGENDA_IA_PERMITIDOS=seu.email@gmail.com
# AGENDA_IA_SESSAO_SEGREDO=uma-frase-longa-e-aleatoria
# AGENDA_ICS=agenda_real/minha.ics
